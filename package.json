{
  "name": "@harshhpatil/logger",
  "version": "1.1.1",
  "description": "A production-ready, zero-config JSON logger for Node/Bun microservices.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "prepublishOnly": "bun test && bun run build"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "keywords": [
    "logger",
    "winston",
    "json",
    "redaction",
    "microservices",
    "devops"
  ],
  "license": "MIT",
  "dependencies": {
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshhpatil/npm-logger.git"
  },
  "homepage": "https://github.com/harshhpatil/npm-logger#readme",
  "bugs": {
    "url": "https://github.com/harshhpatil/npm-logger/issues"
  }
}
